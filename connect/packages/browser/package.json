{
  "name": "@freebirdai/connect-browser",
  "version": "0.2.0",
  "description": "FreeBird Connect add-on: reads API documentation sites that are drawn in the browser, through a headless Chromium.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "connect/packages/browser"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/connect": "workspace:*",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "freebird",
    "api",
    "integration",
    "openapi",
    "connector"
  ],
  "homepage": "https://github.com/Thebooch/FreeBird/tree/main/connect/packages/browser#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
