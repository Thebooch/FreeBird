{
  "name": "@freebirdai/connect-server",
  "version": "0.1.0",
  "description": "FreeBird Connect add-on: HTTP routes for the integration engine, for Fastify, Express and the Next.js App Router.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "connect/packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/connect": "workspace:*",
    "@freebirdai/connect-spec": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "express": "^4.21.1",
    "fastify": "^5.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "freebird",
    "api",
    "integration",
    "openapi",
    "connector"
  ],
  "homepage": "https://github.com/Thebooch/FreeBird/tree/main/connect/packages/server#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
