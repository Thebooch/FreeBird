{
  "name": "@freebirdai/connect-bench",
  "version": "0.0.0",
  "private": true,
  "description": "The integration engine's test bed: mock APIs with answer keys, their transport, and the public APIs the benchmark reads.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./real/*": {
      "types": "./dist/real/*.d.ts",
      "import": "./dist/real/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/connect": "workspace:*",
    "@freebirdai/connect-sandbox": "workspace:*",
    "@freebirdai/connect-spec": "workspace:*"
  },
  "devDependencies": {
    "@freebirdai/connect-postgres": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "zod": "^3.23.8"
  }
}
