{
  "name": "@freebirdai/connect-spec",
  "version": "0.2.0",
  "description": "FreeBird Connect spec: the versioned schemas for connections, connectors, catalog entries, record types, evidence, rhythm and writes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "connect/packages/spec"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/expr": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "freebird",
    "api",
    "integration",
    "openapi",
    "connector"
  ],
  "homepage": "https://github.com/Thebooch/FreeBird/tree/main/connect/packages/spec#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
