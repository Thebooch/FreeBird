{
  "name": "@freebirdai/adapters-db-postgres",
  "version": "0.2.0",
  "description": "Postgres DB adapter for FreeBird, built on Kysely.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "guide/packages/adapters-db-postgres"
  },
  "homepage": "https://github.com/Thebooch/FreeBird#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": "./migrations/001_init.sql",
    "./pglite": {
      "types": "./dist/pglite.d.ts",
      "import": "./dist/pglite.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/pglite.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts src/pglite.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/core": "workspace:*",
    "kysely": "^0.27.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@electric-sql/pglite": "^0.5.4",
    "vitest": "^2.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  }
}
