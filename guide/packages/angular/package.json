{
  "name": "@freebirdai/angular",
  "version": "0.2.0",
  "description": "FreeBird Angular 17+ bindings: provideFreeBird(), FreeBirdService (signals), and standalone headless components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "guide/packages/angular"
  },
  "homepage": "https://github.com/Thebooch/FreeBird#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "module": "./dist/fesm2022/freebird-angular.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/freebird-angular.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "./dist"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "dev": "ng-packagr -p ng-package.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@freebirdai/core": "workspace:*",
    "@freebirdai/core-state": "workspace:*",
    "tslib": "^2.7.0"
  },
  "peerDependencies": {
    "@angular/common": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "rxjs": "^7.5.0"
  },
  "devDependencies": {
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "ng-packagr": "^19.0.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.6.3"
  },
  "sideEffects": false
}
