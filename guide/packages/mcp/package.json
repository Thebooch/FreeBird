{
  "name": "@freebirdai/mcp",
  "version": "0.2.0",
  "description": "FreeBird MCP server: opt-in agent access to registered components and actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "guide/packages/mcp"
  },
  "homepage": "https://github.com/Thebooch/FreeBird#readme",
  "bugs": {
