{
  "name": "@freebirdai/core-state",
  "version": "0.2.0",
  "description": "Framework-agnostic client state store and transport for FreeBird. Wrapped by @freebirdai/react, @freebirdai/vue, @freebirdai/angular.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "guide/packages/core-state"
  },
  "homepage": "https://github.com/Thebooch/FreeBird#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
