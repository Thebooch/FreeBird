{
  "name": "create-freebird",
  "version": "0.1.0",
  "description": "Scaffold and maintain a FreeBird integration: freebird init | check.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "packages/create-freebird"
  },
  "homepage": "https://github.com/Thebooch/FreeBird#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "type": "module",
  "bin": {
    "create-freebird": "./dist/cli.js",
    "freebird": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/cli.ts --format esm --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/codegen": "workspace:*",
    "@freebirdai/manifest": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
