{
  "name": "@freebirdai/react",
  "version": "0.1.0",
  "description": "FreeBird React bindings: provider, hooks, and headless primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thebooch/FreeBird.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Thebooch/FreeBird#readme",
  "bugs": {
    "url": "https://github.com/Thebooch/FreeBird/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freebirdai/core": "workspace:*",
    "@freebirdai/core-state": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
